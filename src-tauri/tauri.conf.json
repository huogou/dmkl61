{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dmkl61",
  "version": "0.3.1",
  "identifier": "com.huogou.dmkl61",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "settings",
        "title": "dmkl61",
        "url": "settings.html",
        "width": 900,
        "height": 600,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "visible": true,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "彦祖",
    "shortDescription": "桌面宠物",
    "longDescription": "一只属于你的桌面小猫。"
  }
}
